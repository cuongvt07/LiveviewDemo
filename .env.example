# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mockup_service

# Assets storage
ASSET_BASE_DIR=./templates

# Redis (optional, for cache invalidation)
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Admin
ADMIN_TOKEN=change-me-in-production

# Optional: map Printerval section -> original artwork URL template.
# Example JSON:
# PRINTERVAL_SECTION_URL_TEMPLATES={"print":"https://cdn.example.com/{folder_path}/{name}.png","cus":"https://cdn.example.com/custom/{design_slug}.png"}
PRINTERVAL_SECTION_URL_TEMPLATES=
