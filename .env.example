## Database
# Async SQLAlchemy URL (asyncpg)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/mockup_service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mockup_service

## Assets storage (paths must be writable by service)
ASSET_BASE_DIR=./templates
INPUTS_BASE_DIR=./inputs
OUTPUT_RENDERS_DIR=./output/renders

## Redis (optional, recommended for cache/invalidations)
REDIS_URL=redis://localhost:6379/0

## Server / process
HOST=0.0.0.0
PORT=8040
WORKERS=1
RENDER_DEVICE=gpu  # or "gpu"

## Admin
# Token used by admin endpoints (change in prod)
ADMIN_TOKEN=change-me-in-production

## Public URL base (used when returning absolute preview URLs)
PUBLIC_BASE_URL=//YOUR_SERVER_IP:8040

## URL analysis / preview defaults
URL_ANALYSIS_PREVIEW_WIDTH=960
URL_ANALYSIS_PREVIEW_HEIGHT=960
URL_ANALYSIS_PREVIEW_QUALITY=90
URL_ANALYSIS_PREVIEW_FIT=contain
URL_ANALYSIS_RENDER_QUALITY=100

## Preview storage TTL (seconds) for temporary preview PNGs
PREVIEW_TTL_SECONDS=300

## Optional mapping for known CDN/template sections -> artwork URL template
# Example JSON (no spaces):
# PRINTERVAL_SECTION_URL_TEMPLATES={"print":"https://cdn.example.com/{folder_path}/{name}.png","cus":"https://cdn.example.com/custom/{design_slug}.png"}
PRINTERVAL_SECTION_URL_TEMPLATES=
